<?xml version="1.0" encoding="UTF-8" ?>
<definitions
        namespace="http://www.montera.com.au/spec/DMN/model-b"
        name="model-B"
        xmlns="https://www.omg.org/spec/DMN/20230324/MODEL/"
        xmlns:dmndi="https://www.omg.org/spec/DMN/20230324/DMNDI/"
        xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/"
        xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/"
        xmlns:feel="https://www.omg.org/spec/DMN/20230324/FEEL/"
        expressionLanguage="https://www.omg.org/spec/DMN/20230324/FEEL/">
  <import name="modelC" namespace="http://www.montera.com.au/spec/DMN/model-c" importType="https://www.omg.org/spec/DMN/20230324/MODEL/"/>

  <decision name="DecisionA" id="_decision_a">
    <variable name="DecisionA" typeRef="number" />
    <informationRequirement>
      <requiredInput href="#_input_a" />
    </informationRequirement>
    <informationRequirement>
      <requiredInput href="http://www.montera.com.au/spec/DMN/model-c#_input_c" />
    </informationRequirement>
    <literalExpression typeRef="number">
      <text>2 * InputA + modelC.InputC</text>
    </literalExpression>
  </decision>

  <inputData name="InputA" id="_input_a">
    <variable name="InputA" typeRef="number" />
  </inputData>
</definitions>
