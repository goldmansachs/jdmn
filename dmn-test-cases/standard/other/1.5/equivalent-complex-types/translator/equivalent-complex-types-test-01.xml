<?xml version="1.0" encoding="UTF-8"?>
<testCases xmlns="http://www.omg.org/spec/DMN/20160719/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <modelName>parent.dmn</modelName>
    <testCase id="001">
        <resultNode name="SimpleParent">
            <expected>
                <component name="age">
                    <value xsi:type="xsd:decimal">4</value>
                </component>
                <component name="name">
                    <value xsi:type="xsd:string">John</value>
                </component>
                <component name="addresses">
                    <list>
                    </list>
                </component>
            </expected>
        </resultNode>
    </testCase>

    <testCase id="002">
        <resultNode name="ListParent">
            <expected>
                <list>
                    <item>
                        <component name="age">
                            <value xsi:type="xsd:decimal">4</value>
                        </component>
                        <component name="name">
                            <value xsi:type="xsd:string">John</value>
                        </component>
                        <component name="addresses">
                            <list>
                            </list>
                        </component>
                    </item>
                </list>
            </expected>
        </resultNode>
    </testCase>
</testCases>